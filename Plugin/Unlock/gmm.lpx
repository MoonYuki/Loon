#!name=G买卖捡漏监控提醒
#!desc=在你浏览G买卖商品列表时，自动检测符合条件的账号并弹窗通知提醒，支持自定义筛选条件。
#!author=MoonYuki
#!tag=辅助工具
#!loon_version=3.5.1(998)

[Argument]
enable=switch, true, tag=启用捡漏监控, desc=开启后自动在浏览时检测符合条件的账号并通知
jobCode=input, "27", tag=职业代码, desc=例如 27 代表祭司
minLevel=input, "81", tag=最低等级, desc=筛选的最低等级
maxLevel=input, "120", tag=最高等级, desc=筛选的最高等级
maxPrice=input, "500", tag=最高价格, desc=商品最高价格限制（元）

[Script]
# 拦截商品列表 API 的响应内容，并在后台进行价格和等级比对
response if ${url} ~= /^https:\/\/www\.gmmsj\.com\/api\/consigntradeapi\/goods\/searchgoodslistV2/i then script("https://raw.githubusercontent.com/MoonYuki/Loon/refs/heads/main/Script/gmm/gmm.js", {${enable}, ${jobCode}, ${minLevel}, ${maxLevel}, ${maxPrice}}) with tag="G买卖捡漏监控", requires_body=true, timeout=5

[MitM]
hostname=www.gmmsj.com
